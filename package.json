{
  "name": "@jungehaie/extractormap",
  "version": "0.1.1",
  "description": "Library to extrace one JSON datastructure from another",
  "scripts": {
    "lint": "./node_modules/tslint/bin/tslint -c ./tslint.json './src/**/*.ts'",
    "test:unit": "./node_modules/jest/bin/jest.js tests/unit",
    "test:unit:watch": "./node_modules/jest/bin/jest.js tests/unit --watch",
    "test:unit:coverage": "./node_modules/jest/bin/jest.js tests/unit --coverage",
    "test:unit:watch:coverage": "./node_modules/jest/bin/jest.js tests/unit --watch --coverage",
    "test:coverage": "./node_modules/jest/bin/jest.js test --coverage",
    "test:mutation": "./node_modules/.bin/stryker run",
    "test:all:coverage": "npm run test:coverage && npm run test:mutation",
    "test": "npm run lint; npm run test:unit && npm run test:mutation",
    "convert:coverage-report": "jq -f mutation-report-to-sonar.jq reports/mutation/mutation.json > reports/mutation-sonar.json",
    "updateSonarQube": "npm run test:all:coverage && npm run convert:coverage-report && sonar-scanner",
    "build": "./node_modules/.bin/tsup",
    "deploy": "npm run lint && npm run test:unit && git push origin master && git push deploy master",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run build"
  },
  "author": "Martin Hilscher",
  "license": "MIT",
  "types": "lib/index.d.ts",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "keywords": [
    "data mapper",
    "extractor"
  ],
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "esbuild-jest"
    },
    "setupFilesAfterEnv": [
      "jest-extended"
    ],
    "testRegex": "((\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "systemTests"
    ],
    "testResultsProcessor": "jest-sonar-reporter",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": -10
      }
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^6.4.1",
    "@stryker-mutator/jest-runner": "^6.4.1",
    "@stryker-mutator/typescript-checker": "^6.4.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.3",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.5.0",
    "jest-extended": "^3.2.4",
    "jest-sonar-reporter": "^2.0.0",
    "load-tsconfig": "^0.2.3",
    "stryker-cli": "^1.0.2",
    "terser": "^5.16.6",
    "tslint": "^6.1.3",
    "tslint-clean-code": "^0.2.10",
    "tsup": "^6.7.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "jsonpath-plus": "^1.1.0"
  }
}
