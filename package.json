{
  "name": "extractormap",
  "version": "0.0.1",
  "description": "Library to extrace one JSON Datastructure from Another",
  "main": "index.js",
  "scripts": {
    "lint": "tslint -c ./tslint.json './src/**/*.ts'",
    "test": "npm run test:unit && npm run test:integration && stryker run ",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:unit:watch": "jest tests/unit --watch",
    "test:integration:watch": "jest tests/integration --watch",
    "test:unit:coverage": "jest tests/unit --coverage",
    "test:integration:coverage": "jest tests/integration --coverage",
    "test:unit:watch:coverage": "jest tests/unit --watch --coverage",
    "test:integration:watch:coverage": "jest tests/integration --watch --coverage"
  },
  "author": "Martin Hilscher",
  "license": "ISC",
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "setupFilesAfterEnv": [
      "jest-extended"
    ],
    "testRegex": "((\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "systemTests"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "devDependencies": {
    "@stryker-mutator/core": "^2.2.1",
    "@stryker-mutator/html-reporter": "^2.2.1",
    "@stryker-mutator/jest-runner": "^2.2.1",
    "@stryker-mutator/typescript": "^2.2.1",
    "@types/jest": "^24.0.22",
    "@types/node": "^12.12.7",
    "jest": "^24.9.0",
    "jest-extended": "^0.11.2",
    "ts-jest": "^24.1.0",
    "tslint-clean-code": "^0.2.10",
    "typescript": "^3.7.2"
  },
  "dependencies": {
    "jsonpath-plus": "^1.1.0"
  }
}
