{
  "name": "@jungehaie/extractormap",
  "version": "3.0.1",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "description": "Library to extract one JSON data structure from another",
  "scripts": {
    "lint:src": "npx eslint ./src",
    "lint:tests": "npx eslint ./tests",
    "lint": "npm run lint:src && npm run lint:tests",
    "test:unit": "npx jest tests/unit",
    "test:unit:watch": "npx jest tests/unit --watch",
    "test:unit:coverage": "npx jest tests/unit --coverage",
    "test:unit:watch:coverage": "npx jest tests/unit --watch --coverage",
    "test:coverage": "npx jest tests/ --coverage",
    "test:mutation": "npx stryker-cli run",
    "test:all:coverage": "npm run test:coverage && npm run test:mutation",
    "test": "npm run lint; npm run test:coverage && npm run test:mutation",
    "build": "npx tsup",
    "deploy": "npm run lint && npm run test:unit && git push origin master && git push deploy master",
    "prepublishOnly": "NODE_ENV=production npm audit && npm run lint && npm run test && npm run build",
    "checkForUpdatedDependencies": "npx npm-check-updates --format group",
    "updatedDependencies": "npx npm-check-updates --upgrade",
    "updatedDependenciesInteractive": "npx npm-check-updates --interactive --format group",
    "prepare": "husky"
  },
  "author": "Martin Hilscher",
  "license": "MIT",
  "types": "lib/index.d.ts",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "keywords": [
    "data mapper",
    "data extractor"
  ],
  "devDependencies": {
    "@commitlint/config-angular": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/jest-runner": "^9.0.1",
    "@stryker-mutator/typescript-checker": "^9.0.1",
    "@stylistic/eslint-plugin": "^5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "commitlint": "^19.8.1",
    "eslint": "^9.30.1",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-extended": "^6.0.0",
    "semantic-release": "^24.2.6",
    "stryker-cli": "^1.0.2",
    "terser": "^5.43.1",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "jsonpath-plus": "^10.3.0"
  }
}
